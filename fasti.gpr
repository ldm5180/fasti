with "config/fasti_config.gpr";
with "tempus";

--  Fasti: the SPARK-proven CBOE/NYSE trading-day calendar.  A pure library
--  (zero IO): every unit carries SPARK_Mode and may depend only on other
--  Fasti units and the tempus date/time library -- never on Ada.Calendar,
--  files, or sockets.  Consumers build it through their Alire profile; the
--  example and test crates select -O3/-O0 with the MODE external (the
--  sml-ada convention).  proof/proof.gpr sources src/ and the tempus pin
--  directly, keeping foreign code out of the proof tree.
project Fasti is

   for Library_Name use "Fasti";
   for Library_Version use
     Project'Library_Name & ".so." & Fasti_Config.Crate_Version;

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Fasti_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib";

   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external ("FASTI_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));
   for Library_Kind use Library_Type;

   package Compiler is
      for Default_Switches ("Ada") use Fasti_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

end Fasti;
