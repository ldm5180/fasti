with "sml";

--  SPARK proof target.  Not built by `alr build`; analysed with
--  `alr exec -- gnatprove -P proof/proof.gpr`.
--
--  Sources the library directly (rather than withing fasti.gpr) because the
--  Alire-generated config gpr withs every dependency's project, which would
--  drag AUnit into the proof tree.  The tempus crate is sourced the same
--  way -- from the Alire pin cache inside this workspace, which `alr build`
--  populates -- so the calendar's date/time dependency is proved in place;
--  tempus units with Sml.*, hence the "sml" with (resolved through `alr
--  exec`).  This tree is exactly the proof harness + src + tempus + sml.
--
--  The pin-cache directory name carries the pinned commit's short sha
--  (alr 2.x commit pins deploy to <crate>_<sha8>), so bumping the tempus
--  pin in alire.toml means updating the matching Source_Dir here -- the
--  proof then can never silently run against a stale checkout.
project Proof is

   for Source_Dirs use
     ("src", "../src", "../alire/cache/pins/tempus_51712384/src");
   for Object_Dir use "obj";

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata");
   end Compiler;

end Proof;
